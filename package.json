{
  "name": "atlas-des-petitions",
  "version": "1.0.0",
  "private": true,
  "description": "L'Atlas des pétitions : moteur citoyen de découverte et de rapprochement des pétitions de l'Assemblée nationale (expérimentation indépendante).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --outDir ../public/atlas --emptyOutDir && node scripts/prerender.mjs ../public/atlas",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:pipeline": "python -m pytest pipeline/tests -q",
    "data:fetch": "python pipeline/run.py fetch",
    "data:build": "python pipeline/run.py build",
    "data:update": "python pipeline/run.py all"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
